{
  "automerge": true,
  "automergeStrategy": "rebase",
  "extends": ["config:recommended"],
  "schedule": ["every weekend"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "rangeStrategy": "pin",
  "pin": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Do not chase engines minimums or the pinned pnpm version",
      "matchDepTypes": ["engines", "packageManager"],
      "enabled": false
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major dependencies",
      "automerge": true,
      "schedule": ["every weekend"]
    }
  ]
}
